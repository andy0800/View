{
  "name": "adrewards-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/app.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "wipe-data": "node scripts/wipeAllData.js",
    "wipe-data-sql": "node scripts/wipeAllDataSQL.js",
    "force-wipe": "node scripts/forceWipeAllData.js",
    "verify-empty": "node scripts/verifyEmptyDatabase.js",
    "inject-test-advertiser": "node scripts/injectTestAdvertiser.js",
    "inject-admin": "node scripts/injectAdmin.js",
    "inject-advertiser-packages": "node scripts/injectAdvertiserPackages.js",
    "populate-sections": "node scripts/populateSections.js",
    "fix-budgets": "node scripts/fixBudgetInconsistencies.js",
    "fix-package-budget": "node scripts/fixPurchasedPackageBudget.js",
    "fix-ad-budgets": "node scripts/fixAdBudgetValues.js",
    "create-test-package": "node scripts/createTestPurchasedPackage.js",
    "create-test-ad": "node scripts/createTestAd.js",
    "create-test-data": "node scripts/createTestData.js",
    "fix-is-active-column": "node scripts/fixIsActiveColumn.js",
    "fix-wallet-schema": "node scripts/fixWalletSchema.js",
    "force-fix-wallet": "node scripts/forceFixWalletSchema.js",
    "test-db-fix": "node scripts/testDatabaseFix.js",
    "test-wallet-associations": "node scripts/testWalletAssociations.js",
    "test-critical-tables": "node scripts/testCriticalTables.js",
    "verify-admin-settings": "node scripts/verifyAdminSettings.js",
    "test-db-init": "node scripts/testDatabaseInit.js",
    "deploy": "npm run migrate && npm run fix-is-active-column && npm run fix-wallet-schema && npm run verify-admin-settings && npm start",
    "deploy:force": "npm run migrate:undo && npm run migrate && npm run fix-is-active-column && npm run fix-wallet-schema && npm run verify-admin-settings && npm start",
    "deploy:full": "node scripts/deployWithMigrations.js && npm start",
    "deploy:check": "node scripts/deployWithMigrations.js",
    "render:deploy": "node scripts/renderDeploy.js && npm start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "aws-sdk": "^2.1370.0",
    "axios": "^1.11.0",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "npm": "^11.4.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.3",
    "stripe": "^12.18.0"
  }
}
